# Committed on purpose - holds no secrets, just build config for
# docker-compose.yml. Auto-loaded by `docker compose`, no --env-file flag
# needed.
#
# Single source of truth for the pinned opencode-ai version used by the
# Docker sandbox. Bump this one line (check `npm view opencode-ai
# version` first), then `docker compose build` - nowhere else in the
# repo should hardcode this number.
OPENCODE_VERSION=1.18.30
