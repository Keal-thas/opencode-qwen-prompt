# Base URL of the Loki instance, no trailing path, e.g. http://192.168.1.100:3100
LOKI_BASE_URL=http://localhost:3100

# Optional - only set these if this Loki instance actually requires them.
# HTTP basic auth:
#LOKI_USERNAME=username
#LOKI_PASSWORD=password
# Multi-tenant Loki / Grafana Cloud-style setups (sets X-Scope-OrgID):
#LOKI_ORG_ID=tenant-id

# Port the HTTP MCP server listens on (optional, defaults to 8091)
LOKI_MCP_PORT=8091

# Timezone offset assumed for a start/end value with no explicit timezone
# (e.g. "2026-09-15T10:00:00") - optional, defaults to +08:00.
#LOKI_DEFAULT_TZ_OFFSET=+08:00
