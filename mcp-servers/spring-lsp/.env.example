# Absolute path to the Spring Boot project to analyze.
SPRING_LSP_WORKSPACE_ROOT=/path/to/your/spring-boot/project

# JDK used to launch spring-boot-language-server itself. It needs JDK 21+
# (confirmed against the vendored 2.5.0-SNAPSHOT build's own
# MANIFEST.MF: `Java-Version: 21`) - separate from whatever JDK your
# project targets. Defaults to whatever `java` resolves to on PATH.
#JAVA_EXECUTABLE=/path/to/jdk21/bin/java

# Port the HTTP MCP server listens on (optional, defaults to 8093 - the
# next free port after mcp-servers/java-lsp's 8092).
SPRING_LSP_MCP_PORT=8093
