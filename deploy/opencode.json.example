{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "prompt": "{file:./system-prompt.txt}"
    },
    "plan": {
      "prompt": "{file:./system-prompt.txt}"
    },
    "general": {
      "prompt": "{file:./system-prompt.txt}"
    }
  },
  "mcp": {
    "oracle": {
      "type": "remote",
      "url": "http://localhost:8090/mcp",
      "enabled": false
    },
    "loki": {
      "type": "remote",
      "url": "http://localhost:8091/mcp",
      "enabled": false
    },
    "memory": {
      "type": "local",
      "command": ["mcp-server-memory"],
      "enabled": false
    }
  }
}
