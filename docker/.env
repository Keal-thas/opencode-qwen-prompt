# Committed on purpose - holds no secrets, just build config for
# docker-compose.yml. Auto-loaded by `docker compose`, no --env-file flag
# needed.
#
# Single source of truth for the pinned opencode-ai version used by the
# Docker sandbox. Bump this one line (check `npm view opencode-ai
# version` first), then `docker compose build` - nowhere else in the
# repo should hardcode this number.
OPENCODE_VERSION=1.18.30

# `oracle` service (see docker-compose.yml) for exercising mcp/oracle/
# against a real Oracle instance - starts automatically with opencode-dev
# (see that service's `depends_on` in docker-compose.yml and
# docker-notes.md's "Oracle test instance" section for why). These
# credentials are throwaway sandbox-only fixtures, never exposed outside
# this docker network, not real secrets - same reasoning as
# OPENCODE_VERSION above for why they're a committed plain value here
# instead of duplicated across docker-compose.yml and mcp/oracle/README.md.
ORACLE_FREE_VERSION=23.26.3-slim
ORACLE_SYS_PASSWORD=SysTestPass1
ORACLE_APP_USER=testuser
ORACLE_APP_USER_PASSWORD=TestPass1

# `loki` service (see docker-compose.loki.yml) for exercising mcp/loki/
# against a real Loki instance - starts automatically via docker/dev.sh,
# same reasoning as the Oracle version pin above. No credentials needed:
# the sandbox's Loki runs with its stock unauthenticated default config.
LOKI_VERSION=3.7.7
